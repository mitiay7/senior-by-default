{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/do/hooks/do-metrics-stop-gate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/do/hooks/do-plan-size-pretooluse.sh"
          }
        ]
      }
    ]
  }
}
