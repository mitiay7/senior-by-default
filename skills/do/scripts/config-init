#!/bin/bash
# config-init — the ONLY supported way to materialize `.claude/do/config.json`
# when Phase 0 Step 1 doesn't find one.
#
# Why a wrapper (not in-doc bash): same lesson as metrics-append. Sub-agents
# proven to bypass in-doc JSON templates — they compose JSON freely via
# Write/echo/python and skip validation. Centralizing emission behind a
# named-args CLI removes that freedom: the only path that writes a
# schema-valid config is calling this with the required flags, and the
# script refuses to overwrite, refuses to bootstrap senior-by-default
# itself, refuses to write at $HOME root, and validates output against
# config.schema.json before commit.
#
# Direct Write/echo to .claude/do/config.json from Phase 0 is an
# anti-pattern (see anti-patterns.md §19c).
#
# Usage:
#   config-init \
#     --repo-root /path/to/repo \
#     --tracker github \
#     --tracker-repo owner/repo \
#     [--stack "Python (FastAPI)"] \
#     [--issue-locale en] \
#     [--specialists default|none]   (default: default — emits recommended preset)
#     [--metrics default|none]       (default: default — emits tier-1 metrics preset)
#
# Exit codes:
#   0  written successfully; stdout: "Config: AUTO-GENERATED → <path>"
#      — carries a " (schema gate SKIPPED — jsonschema unavailable)" suffix
#      when python3-jsonschema was absent and the file was written unvalidated
#   1  rejected (missing/invalid arg, file exists, refused context, schema fail); stderr: "REJECT <reason>"
#   2  I/O failure (could not write); stderr: "IOFAIL <reason>"

set -euo pipefail

die() { echo "REJECT $*" >&2; exit 1; }
iofail() { echo "IOFAIL $*" >&2; exit 2; }

REPO_ROOT=""
TRACKER=""
TRACKER_REPO=""
STACK=""
ISSUE_LOCALE="en"
SPECIALISTS="default"   # default | none
METRICS="default"       # default | none

while [ $# -gt 0 ]; do
  case "$1" in
    --repo-root)     REPO_ROOT="$2";     shift 2 ;;
    --tracker)       TRACKER="$2";       shift 2 ;;
    --tracker-repo)  TRACKER_REPO="$2";  shift 2 ;;
    --stack)         STACK="$2";         shift 2 ;;
    --issue-locale)  ISSUE_LOCALE="$2";  shift 2 ;;
    --specialists)   SPECIALISTS="$2";   shift 2 ;;
    --metrics)       METRICS="$2";       shift 2 ;;
    *) die "unknown flag: $1" ;;
  esac
done

# --- arg validation ---------------------------------------------------------

[ -n "$REPO_ROOT" ] || die "--repo-root required"
[ -d "$REPO_ROOT" ] || die "--repo-root not a directory: $REPO_ROOT"
[ -n "$TRACKER" ]   || die "--tracker required (github|gitlab|none)"
case "$TRACKER" in
  github|gitlab|none) ;;
  *) die "--tracker must be github|gitlab|none (got: $TRACKER)" ;;
esac
case "$SPECIALISTS" in
  default|none) ;;
  *) die "--specialists must be default|none (got: $SPECIALISTS)" ;;
esac
case "$METRICS" in
  default|none) ;;
  *) die "--metrics must be default|none (got: $METRICS)" ;;
esac
# Fail closed on locale even when the jsonschema gate below is unavailable —
# schema pattern is ^[a-z]{2}(-[A-Z]{2})?$ (ISO 639-1, optional region). An
# up-front check turns an opaque schema-gate error into an actionable REJECT.
[[ "$ISSUE_LOCALE" =~ ^[a-z]{2}(-[A-Z]{2})?$ ]] \
  || die "--issue-locale must be an ISO 639-1 code, optional region (en, ru, ja, ko, pt-BR — pattern ^[a-z]{2}(-[A-Z]{2})?\$; got: $ISSUE_LOCALE)"
if [ "$TRACKER" != "none" ] && [ -z "$TRACKER_REPO" ]; then
  die "--tracker-repo required when --tracker=$TRACKER (expected owner/repo)"
fi
if [ -n "$TRACKER_REPO" ] && ! [[ "$TRACKER_REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
  die "--tracker-repo must match owner/repo (got: $TRACKER_REPO)"
fi

# --- context refusals -------------------------------------------------------
# Prevent bootstrapping ourselves / writing into $HOME root by mistake.

REPO_ROOT_ABS="$(cd "$REPO_ROOT" && pwd -P)"
HOME_ABS="$(cd "$HOME" && pwd -P)"

if [ "$REPO_ROOT_ABS" = "$HOME_ABS" ] || [ "$REPO_ROOT_ABS" = "/" ]; then
  die "refuse to init at $REPO_ROOT_ABS (looks like home/root, not a project)"
fi
if [ -f "$REPO_ROOT_ABS/skills/do/SKILL.md" ]; then
  die "refuse to init in senior-by-default itself (this repo IS the skill source)"
fi

OUT_DIR="$REPO_ROOT_ABS/.claude/do"
OUT_PATH="$OUT_DIR/config.json"

if [ -e "$OUT_PATH" ]; then
  die "already exists: $OUT_PATH (auto-init never overwrites)"
fi

# --- compose config (jq guarantees structural validity) ---------------------

command -v jq >/dev/null 2>&1 || die "jq not installed (required for config compose)"

NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "$TRACKER" = "none" ]; then
  TRACKER_BLOCK="$(jq -n --arg t "$TRACKER" '{type: $t}')"
else
  TRACKER_BLOCK="$(jq -n --arg t "$TRACKER" --arg r "$TRACKER_REPO" \
    '{type: $t, repo: $r, required_labels: ["task"], domain_labels: []}')"
fi

# Default specialists preset — references plugins from the two recommended
# marketplaces (anthropics/claude-plugins-official + wshobson/agents).
# If user hasn't installed them, /do falls back to Opus inline review per
# specialist group (no error). Setup notes below tell user how to install.
if [ "$SPECIALISTS" = "none" ]; then
  SPECIALISTS_BLOCK="null"
  SPECIALISTS_NOTE=""
else
  SPECIALISTS_BLOCK="$(jq -n '{
    backend_plan: [
      "backend-development:backend-architect",
      "backend-development:security-auditor",
      "database-design:database-architect"
    ],
    frontend_plan: [
      "ui-design:design-system-architect",
      "ui-design:ui-designer",
      "javascript-typescript:typescript-pro"
    ],
    backend_audit: [
      "code-refactoring:code-reviewer",
      "backend-development:backend-architect",
      "backend-development:security-auditor"
    ],
    frontend_audit: [
      "code-refactoring:code-reviewer",
      "ui-design:ui-designer",
      "pr-review-toolkit:silent-failure-hunter",
      "ui-design:accessibility-expert"
    ],
    migration_audit: [
      "database-design:database-architect"
    ]
  }')"
  SPECIALISTS_NOTE=" The specialists block references plugins from two marketplaces — install once via Claude Code: \`/plugin marketplace add anthropics/claude-plugins-official\` + \`/plugin marketplace add wshobson/agents\`, then \`/plugin install backend-development@claude-code-workflows\` (also: code-refactoring, database-design, ui-design, javascript-typescript — all @claude-code-workflows; plus pr-review-toolkit@claude-plugins-official). If any plugin isn't installed, /do falls back to Opus inline review for that specialist group (no error)."
fi

# Default metrics preset — matches config-schema.md documented defaults.
# `log_path` uses {repo_slug} placeholder resolved by Phase 4.11 at write time.
# Writes to ~/.claude/do/metrics/ (cross-project home location) so a single
# daily-report scanner sees all repos' telemetry.
if [ "$METRICS" = "none" ]; then
  METRICS_BLOCK="null"
  METRICS_NOTE=""
else
  METRICS_BLOCK="$(jq -n '{
    log_path: "~/.claude/do/metrics/{repo_slug}.jsonl",
    include_phase_durations: true,
    tier: 1,
    capture_failure_details: true,
    capture_self_review_calibration: true,
    capture_specialist_iterations: true,
    max_string_length: 500
  }')"
  METRICS_NOTE=" Metrics tier-1 preset: JSONL log at ~/.claude/do/metrics/<repo-slug>.jsonl (cross-project, scannable by a daily report). Captures phase durations, failure details, self-review calibration, specialist iterations. Opt out per-task via --no-metrics or set metrics.log_path=null to disable entirely."
fi

CONFIG_JSON="$(jq -n \
  --arg now "$NOW" \
  --arg stack "$STACK" \
  --arg locale "$ISSUE_LOCALE" \
  --arg specialists_note "$SPECIALISTS_NOTE" \
  --arg metrics_note "$METRICS_NOTE" \
  --argjson tracker "$TRACKER_BLOCK" \
  --argjson specialists "$SPECIALISTS_BLOCK" \
  --argjson metrics "$METRICS_BLOCK" \
  '{
     version: 1,
     _meta: {
       auto_generated_by: "senior-by-default Phase 0 auto-init",
       auto_generated_at: $now,
       auto_generated_for_stack: ($stack | if . == "" then null else . end),
       _setup_notes: ("Auto-init writes version + issue_tracker + issue_locale + specialists preset + metrics preset." + $specialists_note + $metrics_note + " For context_doc, workspace.repos, ui_gate, acceptance_extensions, naming overrides — see examples/ in senior-by-default repo and extend this file. /do re-reads on every run; no reload needed.")
     },
     issue_tracker: $tracker,
     issue_locale: $locale
   }
   + (if $specialists == null then {} else {specialists: $specialists} end)
   + (if $metrics == null then {} else {metrics: $metrics} end)')" || iofail "jq compose failed"

# --- schema validation (best-effort: skip if tooling missing) ---------------
# Skips are NEVER silent: when the gate can't run, the success line below
# carries a visible " (schema gate SKIPPED — jsonschema unavailable)" suffix.
# Pre-fix, a jsonschema-less host wrote the config unvalidated under the
# identical clean announce — indistinguishable from a validated write.
# phase-0-setup.md matches "Config: AUTO-GENERATED"* as a prefix glob, so the
# suffix rides through; it is wrapper-emitted, hence not a §19c annotation.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCHEMA_PATH="$SCRIPT_DIR/../references/config.schema.json"

SCHEMA_GATE_SUFFIX=" (schema gate SKIPPED — jsonschema unavailable)"
if [ -f "$SCHEMA_PATH" ] && command -v python3 >/dev/null 2>&1 \
   && python3 -c "import jsonschema" 2>/dev/null; then
  SCHEMA_GATE_SUFFIX=""
  if ! printf '%s' "$CONFIG_JSON" | SCHEMA_PATH="$SCHEMA_PATH" python3 -c '
import sys, os, json, jsonschema
schema = json.load(open(os.environ["SCHEMA_PATH"]))
data = json.loads(sys.stdin.read())
try:
    jsonschema.validate(data, schema)
except jsonschema.ValidationError as e:
    print(f"schema validation failed: {e.message} at {list(e.absolute_path)}", file=sys.stderr)
    sys.exit(1)
' 2>/tmp/config-init-schema-err.$$; then
    err="$(cat /tmp/config-init-schema-err.$$ 2>/dev/null || echo "unknown")"
    rm -f /tmp/config-init-schema-err.$$
    die "synthesized config failed schema gate: $err"
  fi
  rm -f /tmp/config-init-schema-err.$$
fi

# --- atomic write -----------------------------------------------------------

mkdir -p "$OUT_DIR" || iofail "could not create $OUT_DIR"

TMP="${OUT_PATH}.tmp.$$"
trap 'rm -f "$TMP"' EXIT
printf '%s\n' "$CONFIG_JSON" > "$TMP" || iofail "could not write $TMP"
mv -- "$TMP" "$OUT_PATH" || iofail "could not rename $TMP → $OUT_PATH"
trap - EXIT

echo "Config: AUTO-GENERATED → $OUT_PATH$SCHEMA_GATE_SUFFIX"
