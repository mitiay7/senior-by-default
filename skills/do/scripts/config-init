#!/bin/bash
# config-init — the ONLY supported way to materialize `.claude/do/config.json`
# when Phase 0 Step 1 doesn't find one.
#
# Why a wrapper (not in-doc bash): same lesson as metrics-append. Sub-agents
# proven to bypass in-doc JSON templates — they compose JSON freely via
# Write/echo/python and skip validation. Centralizing emission behind a
# named-args CLI removes that freedom: the only path that writes a
# schema-valid config is calling this with the required flags, and the
# script refuses to overwrite, refuses to bootstrap senior-by-default
# itself, refuses to write at $HOME root, and validates output against
# config.schema.json before commit.
#
# Direct Write/echo to .claude/do/config.json from Phase 0 is an
# anti-pattern (see anti-patterns.md §19c).
#
# Usage:
#   config-init \
#     --repo-root /path/to/repo \
#     --tracker github \
#     --tracker-repo owner/repo \
#     [--stack "Python (FastAPI)"] \
#     [--issue-locale en] \
#     [--specialists default|none]   (default: default — emits the recommended
#                                     preset VERIFIED against
#                                     ~/.claude/plugins/installed_plugins.json:
#                                     missing plugins dropped, empty groups
#                                     omitted — see "Specialists:" stdout line)
#     [--metrics default|none]       (default: default — emits tier-1 metrics preset)
#
# Exit codes:
#   0  written successfully; stdout: "Config: AUTO-GENERATED → <path>"
#      — carries a " (schema gate SKIPPED — jsonschema unavailable)" suffix
#      when python3-jsonschema was absent and the file was written unvalidated
#      — for --tracker github|gitlab, a SECOND stdout line follows (tracker
#        preflight verdict): "Tracker: <type> OK (<tool version>; auth
#        account: <login>)" when the CLI is present + authenticated, or
#        "Tracker: DEGRADED to none (<tool> missing|unauthenticated — <fix>)"
#        when it isn't — in which case the file is written with type:none and
#        _meta.tracker_degraded_from records the intended type. The OK form's
#        version + account are runtime-probed (anti-fabrication tell, §19c);
#        the DEGRADED form is an honest degraded state, copyable on purpose.
#      — for --specialists default (the default), a FURTHER stdout line
#        follows (specialists preset verdict): "Specialists: PRESET VERIFIED
#        (N/M plugins installed: <name@version, …>)" | "Specialists: PRESET
#        FILTERED (…)" | "Specialists: PRESET EMPTY (…)" | "Specialists:
#        UNVERIFIED (…)". The name@version list is read at runtime from
#        ~/.claude/plugins/installed_plugins.json — not composable from spec
#        text (§19c tell standard).
#   1  rejected (missing/invalid arg, file exists, refused context, schema fail); stderr: "REJECT <reason>"
#   2  I/O failure (could not write); stderr: "IOFAIL <reason>"

set -euo pipefail

die() { echo "REJECT $*" >&2; exit 1; }
iofail() { echo "IOFAIL $*" >&2; exit 2; }

REPO_ROOT=""
TRACKER=""
TRACKER_REPO=""
STACK=""
ISSUE_LOCALE="en"
SPECIALISTS="default"   # default | none
METRICS="default"       # default | none

while [ $# -gt 0 ]; do
  case "$1" in
    --repo-root)     REPO_ROOT="$2";     shift 2 ;;
    --tracker)       TRACKER="$2";       shift 2 ;;
    --tracker-repo)  TRACKER_REPO="$2";  shift 2 ;;
    --stack)         STACK="$2";         shift 2 ;;
    --issue-locale)  ISSUE_LOCALE="$2";  shift 2 ;;
    --specialists)   SPECIALISTS="$2";   shift 2 ;;
    --metrics)       METRICS="$2";       shift 2 ;;
    *) die "unknown flag: $1" ;;
  esac
done

# --- arg validation ---------------------------------------------------------

# Tilde expansion (audit #18): a QUOTED '~' in --repo-root never reaches the
# shell's expansion — pre-fix it failed the -d check with a misleading message
# (or resolved against a literal ./~ directory if one existed).
# shellcheck disable=SC2088  # matching the LITERAL quoted tilde is the point
case "$REPO_ROOT" in
  "~")   REPO_ROOT="$HOME" ;;
  "~/"*) REPO_ROOT="$HOME/${REPO_ROOT#\~/}" ;;
esac

[ -n "$REPO_ROOT" ] || die "--repo-root required"
[ -d "$REPO_ROOT" ] || die "--repo-root not a directory: $REPO_ROOT"
[ -n "$TRACKER" ]   || die "--tracker required (github|gitlab|none)"
case "$TRACKER" in
  github|gitlab|none) ;;
  *) die "--tracker must be github|gitlab|none (got: $TRACKER)" ;;
esac
case "$SPECIALISTS" in
  default|none) ;;
  *) die "--specialists must be default|none (got: $SPECIALISTS)" ;;
esac
case "$METRICS" in
  default|none) ;;
  *) die "--metrics must be default|none (got: $METRICS)" ;;
esac
# Fail closed on locale even when the jsonschema gate below is unavailable —
# schema pattern is ^[a-z]{2}(-[A-Z]{2})?$ (ISO 639-1, optional region). An
# up-front check turns an opaque schema-gate error into an actionable REJECT.
[[ "$ISSUE_LOCALE" =~ ^[a-z]{2}(-[A-Z]{2})?$ ]] \
  || die "--issue-locale must be an ISO 639-1 code, optional region (en, ru, ja, ko, pt-BR — pattern ^[a-z]{2}(-[A-Z]{2})?\$; got: $ISSUE_LOCALE)"
if [ "$TRACKER" != "none" ] && [ -z "$TRACKER_REPO" ]; then
  die "--tracker-repo required when --tracker=$TRACKER (expected owner/repo)"
fi
if [ -n "$TRACKER_REPO" ] && ! [[ "$TRACKER_REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
  die "--tracker-repo must match owner/repo (got: $TRACKER_REPO)"
fi

# --- context refusals -------------------------------------------------------
# Prevent bootstrapping ourselves / writing into $HOME root by mistake.

REPO_ROOT_ABS="$(cd "$REPO_ROOT" && pwd -P)"
HOME_ABS="$(cd "$HOME" && pwd -P)"

if [ "$REPO_ROOT_ABS" = "$HOME_ABS" ] || [ "$REPO_ROOT_ABS" = "/" ]; then
  die "refuse to init at $REPO_ROOT_ABS (looks like home/root, not a project)"
fi
if [ -f "$REPO_ROOT_ABS/skills/do/SKILL.md" ]; then
  die "refuse to init in senior-by-default itself (this repo IS the skill source)"
fi

OUT_DIR="$REPO_ROOT_ABS/.claude/do"
OUT_PATH="$OUT_DIR/config.json"

if [ -e "$OUT_PATH" ]; then
  die "already exists: $OUT_PATH (auto-init never overwrites)"
fi

# --- tracker tool preflight (github/gitlab only) -----------------------------
# Fresh-machine gate (audit #13): the remote URL alone used to commit the
# pipeline to a tracker CLI that may be absent or unauthenticated — the most
# common fresh-machine state (git present, gh absent) then surfaced as a raw
# "gh: command not found" mid-pipeline with no spec'd fallback. Probe presence
# + auth BEFORE writing type:github/gitlab; on failure DEGRADE to type:none
# (Phase 1 is skipped with an explicit announce — see phase-1-issue.md) and
# say so on stdout. The OK line's tool version + auth account are runtime
# probes — not composable from spec text (the §19c tell standard).

TRACKER_LINE=""
TRACKER_NOTE=""
DEGRADED_FROM=""
DEGRADED_REASON=""

degrade_tracker() {
  # $1 = reason token ("<tool> missing" | "<tool> unauthenticated"), $2 = remedy
  DEGRADED_FROM="$TRACKER"
  DEGRADED_REASON="$1"
  TRACKER_LINE="Tracker: DEGRADED to none ($1 — $2)"
  TRACKER_NOTE=" Tracker DEGRADED: remote looks like $TRACKER but $1 — Phase 1 (issue) is SKIPPED under type:none; the rest of the pipeline runs. To restore: $2, then set issue_tracker to {\"type\": \"$TRACKER\", \"repo\": \"$TRACKER_REPO\"}."
  TRACKER="none"
  TRACKER_REPO=""
}

if [ "$TRACKER" = "github" ] || [ "$TRACKER" = "gitlab" ]; then
  TOOL="gh"
  INSTALL_HINT="install gh (https://cli.github.com, brew install gh) then run 'gh auth login'"
  if [ "$TRACKER" = "gitlab" ]; then
    TOOL="glab"
    INSTALL_HINT="install glab (https://gitlab.com/gitlab-org/cli, brew install glab) then run 'glab auth login'"
  fi
  if ! command -v "$TOOL" >/dev/null 2>&1; then
    degrade_tracker "$TOOL missing" "$INSTALL_HINT"
  elif ! AUTH_OUT="$("$TOOL" auth status 2>&1)"; then
    degrade_tracker "$TOOL unauthenticated" "run '$TOOL auth login'"
  else
    TOOL_VER="$("$TOOL" --version 2>/dev/null | head -1 || true)"
    AUTH_ACCT="$(printf '%s\n' "$AUTH_OUT" | grep -oE '(account|as) [A-Za-z0-9._@-]+' | head -1 | cut -d' ' -f2 || true)"
    TRACKER_LINE="Tracker: $TRACKER OK (${TOOL_VER:-$TOOL}; auth account: ${AUTH_ACCT:-verified})"
  fi
fi

# --- compose config (jq guarantees structural validity) ---------------------

command -v jq >/dev/null 2>&1 || die "jq not installed (required for config compose)"

NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "$TRACKER" = "none" ]; then
  TRACKER_BLOCK="$(jq -n --arg t "$TRACKER" '{type: $t}')"
else
  TRACKER_BLOCK="$(jq -n --arg t "$TRACKER" --arg r "$TRACKER_REPO" \
    '{type: $t, repo: $r, required_labels: ["task"], domain_labels: []}')"
fi

# Default specialists preset — references plugins from the two recommended
# marketplaces (anthropics/claude-plugins-official + wshobson/agents).
# VERIFIED against ~/.claude/plugins/installed_plugins.json before writing
# (audit #9): pre-fix the preset was written blind, so every new-machine setup
# got all 6 plugin references regardless of what's installed — re-arming the
# phantom-plugin incident class (a configured-but-absent specialist surfaced
# at runtime as an improvised fallback to the WRONG model: "Specialists not
# available — falling back to Sonnet"). Now:
#   - manifest readable (version-2 shape: {plugins: {"<name>@<marketplace>":
#     [{version, …}]}}) → entries whose plugin is missing are DROPPED, groups
#     that become empty are OMITTED, and a "Specialists:" stdout line reports
#     both lists. Plugin versions in the line come from the manifest —
#     runtime-probed, not composable from spec text (§19c tell standard).
#   - manifest unreadable → full preset with an honest UNVERIFIED line. Either
#     way the spawn-time rule holds: a configured-but-unavailable specialist
#     falls back to Opus inline review, NEVER Sonnet (phase-2-implementation.md
#     "Plan Review" / phase-3-review.md §3.6).
PLUGINS_MANIFEST="$HOME/.claude/plugins/installed_plugins.json"
SPECIALISTS_LINE=""
if [ "$SPECIALISTS" = "none" ]; then
  SPECIALISTS_BLOCK="null"
  SPECIALISTS_NOTE=""
else
  PRESET_FULL="$(jq -n '{
    backend_plan: [
      "backend-development:backend-architect",
      "backend-development:security-auditor",
      "database-design:database-architect"
    ],
    frontend_plan: [
      "ui-design:design-system-architect",
      "ui-design:ui-designer",
      "javascript-typescript:typescript-pro"
    ],
    backend_audit: [
      "code-refactoring:code-reviewer",
      "backend-development:backend-architect",
      "backend-development:security-auditor"
    ],
    frontend_audit: [
      "code-refactoring:code-reviewer",
      "ui-design:ui-designer",
      "pr-review-toolkit:silent-failure-hunter",
      "ui-design:accessibility-expert"
    ],
    migration_audit: [
      "database-design:database-architect"
    ]
  }')"
  INSTALL_NOTE=" The specialists block references plugins from two marketplaces — install once via Claude Code: \`/plugin marketplace add anthropics/claude-plugins-official\` + \`/plugin marketplace add wshobson/agents\`, then \`/plugin install backend-development@claude-code-workflows\` (also: code-refactoring, database-design, ui-design, javascript-typescript — all @claude-code-workflows; plus pr-review-toolkit@claude-plugins-official). If a configured plugin is missing at spawn time, /do falls back to Opus inline review for that specialist seat (never Sonnet, no error)."
  if [ -r "$PLUGINS_MANIFEST" ] && SPEC_VERIFY="$(jq -c --argjson preset "$PRESET_FULL" '
        (.plugins // {}) as $map
        | ($map | keys) as $keys
        | ($preset | [to_entries[].value[] | split(":")[0]] | unique) as $wanted
        | ($wanted | map(. as $p | select(any($keys[]; startswith($p + "@"))))) as $present
        | ($wanted - $present) as $missing
        | ($preset | to_entries
            | map(.value |= map(select((split(":")[0]) as $p | ($present | index($p)) != null)))) as $ents
        | {
            filtered:     ($ents | map(select((.value | length) > 0)) | from_entries),
            omitted:      ($ents | map(select((.value | length) == 0) | .key)),
            present_ver:  ($present | map(. as $p
              | (($keys | map(select(startswith($p + "@"))))[0]) as $k
              | $p + "@" + ((try ($map[$k][0].version) catch null) // "?"))),
            missing:      $missing,
            install_cmds: ({"pr-review-toolkit": "claude-plugins-official"} as $mkt
              | $missing | map("/plugin install " + . + "@" + ($mkt[.] // "claude-code-workflows"))),
            n_wanted:     ($wanted | length),
            n_present:    ($present | length)
          }' "$PLUGINS_MANIFEST" 2>/dev/null)"; then
    SPECIALISTS_BLOCK="$(printf '%s' "$SPEC_VERIFY" | jq -c 'if (.filtered | length) == 0 then null else .filtered end')"
    N_PRESENT="$(printf '%s' "$SPEC_VERIFY" | jq -r '.n_present')"
    N_WANTED="$(printf '%s' "$SPEC_VERIFY" | jq -r '.n_wanted')"
    PRESENT_VER="$(printf '%s' "$SPEC_VERIFY" | jq -r '.present_ver | join(", ")')"
    MISSING_LIST="$(printf '%s' "$SPEC_VERIFY" | jq -r '.missing | join(", ")')"
    OMITTED_LIST="$(printf '%s' "$SPEC_VERIFY" | jq -r '.omitted | join(", ")')"
    INSTALL_LIST="$(printf '%s' "$SPEC_VERIFY" | jq -r '.install_cmds | join("; ")')"
    if [ "$N_PRESENT" -eq "$N_WANTED" ]; then
      SPECIALISTS_LINE="Specialists: PRESET VERIFIED ($N_PRESENT/$N_WANTED plugins installed: $PRESENT_VER)"
      SPECIALISTS_NOTE="$INSTALL_NOTE"
    elif [ "$N_PRESENT" -eq 0 ]; then
      SPECIALISTS_LINE="Specialists: PRESET EMPTY (0/$N_WANTED preset plugins installed — specialists block OMITTED; missing: $MISSING_LIST; to enable: $INSTALL_LIST, then re-init or add the block per examples/)"
      SPECIALISTS_NOTE=" Specialists preset OMITTED at init: none of the $N_WANTED preset plugins were installed (missing: $MISSING_LIST). To enable specialist review: $INSTALL_LIST, then add the specialists block (see examples/ in the senior-by-default repo)."
    else
      SPECIALISTS_LINE="Specialists: PRESET FILTERED ($N_PRESENT/$N_WANTED plugins installed: $PRESENT_VER; MISSING: $MISSING_LIST — entries dropped${OMITTED_LIST:+, groups omitted: $OMITTED_LIST}; to restore: $INSTALL_LIST, then re-add)"
      SPECIALISTS_NOTE="$INSTALL_NOTE Preset FILTERED at init: dropped entries for missing plugin(s) $MISSING_LIST${OMITTED_LIST:+ (groups omitted: $OMITTED_LIST)}; restore: $INSTALL_LIST, then re-add the dropped entries."
    fi
  else
    SPECIALISTS_BLOCK="$PRESET_FULL"
    SPECIALISTS_LINE="Specialists: UNVERIFIED (no readable ~/.claude/plugins/installed_plugins.json — full preset written; a configured-but-missing plugin falls back to Opus inline review at spawn time, never Sonnet)"
    SPECIALISTS_NOTE="$INSTALL_NOTE"
  fi
fi

# Default metrics preset — matches config-schema.md documented defaults.
# `log_path` uses {repo_slug} placeholder resolved by Phase 4.11 at write time.
# Writes to ~/.claude/do/metrics/ (cross-project home location) so a single
# metrics-report run sees all repos' telemetry.
if [ "$METRICS" = "none" ]; then
  METRICS_BLOCK="null"
  METRICS_NOTE=""
else
  METRICS_BLOCK="$(jq -n '{
    log_path: "~/.claude/do/metrics/{repo_slug}.jsonl",
    include_phase_durations: true,
    tier: 1,
    capture_failure_details: true,
    capture_self_review_calibration: true,
    capture_specialist_iterations: true,
    max_string_length: 500
  }')"
  METRICS_NOTE=" Metrics tier-1 preset: JSONL log at ~/.claude/do/metrics/<repo-slug>.jsonl (cross-project, scannable by a daily report). Captures phase durations, failure details, self-review calibration, specialist iterations. Opt out per-task via --no-metrics or set metrics.log_path=null to disable entirely."
fi

CONFIG_JSON="$(jq -n \
  --arg now "$NOW" \
  --arg stack "$STACK" \
  --arg locale "$ISSUE_LOCALE" \
  --arg specialists_note "$SPECIALISTS_NOTE" \
  --arg metrics_note "$METRICS_NOTE" \
  --arg tracker_note "$TRACKER_NOTE" \
  --arg degraded_from "$DEGRADED_FROM" \
  --arg degraded_reason "$DEGRADED_REASON" \
  --argjson tracker "$TRACKER_BLOCK" \
  --argjson specialists "$SPECIALISTS_BLOCK" \
  --argjson metrics "$METRICS_BLOCK" \
  '{
     version: 1,
     _meta: ({
       auto_generated_by: "senior-by-default Phase 0 auto-init",
       auto_generated_at: $now,
       auto_generated_for_stack: ($stack | if . == "" then null else . end),
       _setup_notes: ("Auto-init writes version + issue_tracker + issue_locale + specialists preset + metrics preset." + $specialists_note + $metrics_note + $tracker_note + " For context_doc, workspace.repos, ui_gate, acceptance_extensions, naming overrides — see examples/ in senior-by-default repo and extend this file. /do re-reads on every run; no reload needed.")
     } + (if $degraded_from == "" then {} else {tracker_degraded_from: $degraded_from, tracker_degraded_reason: $degraded_reason} end)),
     issue_tracker: $tracker,
     issue_locale: $locale
   }
   + (if $specialists == null then {} else {specialists: $specialists} end)
   + (if $metrics == null then {} else {metrics: $metrics} end)')" || iofail "jq compose failed"

# --- schema validation (best-effort: skip if tooling missing) ---------------
# Skips are NEVER silent: when the gate can't run, the success line below
# carries a visible " (schema gate SKIPPED — jsonschema unavailable)" suffix.
# Pre-fix, a jsonschema-less host wrote the config unvalidated under the
# identical clean announce — indistinguishable from a validated write.
# phase-0-setup.md matches "Config: AUTO-GENERATED"* as a prefix glob, so the
# suffix rides through; it is wrapper-emitted, hence not a §19c annotation.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCHEMA_PATH="$SCRIPT_DIR/../references/config.schema.json"

SCHEMA_GATE_SUFFIX=" (schema gate SKIPPED — jsonschema unavailable)"
if [ -f "$SCHEMA_PATH" ] && command -v python3 >/dev/null 2>&1 \
   && python3 -c "import jsonschema" 2>/dev/null; then
  SCHEMA_GATE_SUFFIX=""
  if ! printf '%s' "$CONFIG_JSON" | SCHEMA_PATH="$SCHEMA_PATH" python3 -c '
import sys, os, json, jsonschema
schema = json.load(open(os.environ["SCHEMA_PATH"]))
data = json.loads(sys.stdin.read())
try:
    jsonschema.validate(data, schema)
except jsonschema.ValidationError as e:
    print(f"schema validation failed: {e.message} at {list(e.absolute_path)}", file=sys.stderr)
    sys.exit(1)
' 2>/tmp/config-init-schema-err.$$; then
    err="$(cat /tmp/config-init-schema-err.$$ 2>/dev/null || echo "unknown")"
    rm -f /tmp/config-init-schema-err.$$
    die "synthesized config failed schema gate: $err"
  fi
  rm -f /tmp/config-init-schema-err.$$
fi

# --- atomic write -----------------------------------------------------------

mkdir -p "$OUT_DIR" || iofail "could not create $OUT_DIR"

TMP="${OUT_PATH}.tmp.$$"
trap 'rm -f "$TMP"' EXIT
printf '%s\n' "$CONFIG_JSON" > "$TMP" || iofail "could not write $TMP"
# Atomic fail-if-exists commit (audit #18d): the early -e check above is a
# fast-path courtesy only — between it and this write, a PARALLEL auto-init
# (documented real workflow: N /do agents on one repo) can land its own
# config, and `mv` would silently clobber it despite the never-overwrite
# guarantee. ln(2) is atomic and FAILS when the target exists: the first init
# wins, the loser dies loudly instead of overwriting.
if ! ln "$TMP" "$OUT_PATH" 2>/dev/null; then
  if [ -e "$OUT_PATH" ]; then
    die "already exists: $OUT_PATH (lost an init race — a parallel auto-init committed first; re-read that file, do not retry)"
  fi
  iofail "could not link $TMP → $OUT_PATH"
fi
rm -f "$TMP"
trap - EXIT
# Content-based post-write verify (audit #18): the committed file must parse —
# catches truncated/partial writes behind the success announce.
jq -e . "$OUT_PATH" >/dev/null 2>&1 \
  || iofail "post-write verify failed: $OUT_PATH is not parseable JSON (truncated write?)"

echo "Config: AUTO-GENERATED → $OUT_PATH$SCHEMA_GATE_SUFFIX"
# Tracker preflight + specialists preset verdicts ride as extra lines so
# phase-0's "Config: AUTO-GENERATED"* prefix glob keeps matching the captured
# stdout; phase-0 carries every line into the announce verbatim.
if [ -n "$TRACKER_LINE" ]; then
  echo "$TRACKER_LINE"
fi
if [ -n "$SPECIALISTS_LINE" ]; then
  echo "$SPECIALISTS_LINE"
fi
