#!/bin/bash
# plan-size-check — the ONLY supported way to produce the Phase 2.0
# plan-size sanity-check decision. Wrapper script (not inline bash in spec)
# because the v0.6.0 inline-bash approach was systematically bypassed:
# 32 post-deploy entries had 0 re-bumps despite 16 of 21 M-tasks shipping
# >600 lines or >8 files. Same fabrication pattern as caveman v1/v2:
# orchestrator reads the threshold values + case-statement in the spec,
# decides "yeah, looks fine to me", composes no output, no signal in
# metrics that the check was skipped.
#
# Structural enforcement: thresholds + case-statement live ONLY in the
# script. The spec invokes the wrapper; orchestrator cannot decide
# "plan fits" without the wrapper printing it. And the output includes
# an anti-fabrication tell: the actual computed cap values for the
# current bucket are echoed back as part of the announce line, so
# off-line guesses are detectable (orchestrator doesn't know the
# wrapper's internal table without running it).
#
# Usage:
#   plan-size-check \
#     --current-complexity T|L|M|H \
#     --planned-files N \
#     --planned-lines N
#
# Exit codes:
#   0  decision made; stdout is one of:
#        "Phase 2.0: PASS — planned N files / N lines fits <C> bucket (caps: F files / L lines)"
#        "Phase 2.0: REBUMP <C>→H — planned N files / N lines exceeds <C> caps (F files / L lines)"
#        "Phase 2.0: SPLIT-REQUIRED — H bucket also exceeded by planned N files / N lines (caps: F / L)"
#   1  rejected (bad/missing arg, non-numeric values); stderr: "REJECT <reason>"

set -euo pipefail

die() { echo "REJECT $*" >&2; exit 1; }

CURRENT=""
PLANNED_FILES=""
PLANNED_LINES=""

while [ $# -gt 0 ]; do
  case "$1" in
    --current-complexity) CURRENT="$2";        shift 2 ;;
    --planned-files)      PLANNED_FILES="$2";  shift 2 ;;
    --planned-lines)      PLANNED_LINES="$2";  shift 2 ;;
    *) die "unknown flag: $1" ;;
  esac
done

[ -n "$CURRENT" ]        || die "--current-complexity required (T|L|M|H)"
[ -n "$PLANNED_FILES" ]  || die "--planned-files required (integer)"
[ -n "$PLANNED_LINES" ]  || die "--planned-lines required (integer)"

[[ "$CURRENT" =~ ^[TLMH]$ ]]    || die "--current-complexity must be T|L|M|H, got: $CURRENT"
[[ "$PLANNED_FILES" =~ ^[0-9]+$ ]] || die "--planned-files must be non-negative integer, got: $PLANNED_FILES"
[[ "$PLANNED_LINES" =~ ^[0-9]+$ ]] || die "--planned-lines must be non-negative integer, got: $PLANNED_LINES"

# Bucket caps — single source of truth. These match the Phase 0 complexity
# matrix in phase-0-setup.md but are duplicated here ON PURPOSE so the
# wrapper is self-contained and the spec doesn't carry copyable threshold
# values (anti-fabrication: orchestrator skipping the wrapper can't guess
# the exact numbers).
#
# H ceiling (25 files / 1500 lines) is a REAL bound, not the old effectively-
# unbounded 999/99999 — with the old values the SPLIT-REQUIRED branch was dead
# code (no plan ever exceeded 99999 lines), so genuinely-huge H tasks sailed
# through to a 4000-line unreviewable PR. Rationale: a single PR beyond ~1500
# added lines or ~25 files cannot be meaningfully reviewed in one sitting and
# should be decomposed into sequenced sub-issues. The H cap sits BELOW the
# Phase 3 pr_size block default (2000 lines / 50 files) on purpose: plan-time
# (estimate) catches the obviously-too-big before an hour of Sonnet time is
# spent; the 1500→2000 band is the margin for estimate error that Phase 3
# pr_size warns on; >2000 actual is the hard block backstop. Audit (254 entries,
# May 14–24): 8 PRs shipped >2000 lines as pr_size=warn (never blocked); several
# H tasks hit 3000–4166 lines. SPLIT-REQUIRED firing at plan time prevents that.
case "$CURRENT" in
  T) MAX_FILES=2;   MAX_LINES=50    ;;
  L) MAX_FILES=3;   MAX_LINES=200   ;;
  M) MAX_FILES=8;   MAX_LINES=600   ;;
  H) MAX_FILES=25;  MAX_LINES=1500  ;;
esac

if [ "$PLANNED_FILES" -le "$MAX_FILES" ] && [ "$PLANNED_LINES" -le "$MAX_LINES" ]; then
  echo "Phase 2.0: PASS — planned $PLANNED_FILES files / $PLANNED_LINES lines fits $CURRENT bucket (caps: $MAX_FILES files / $MAX_LINES lines)"
  exit 0
fi

if [ "$CURRENT" != "H" ]; then
  echo "Phase 2.0: REBUMP ${CURRENT}→H — planned $PLANNED_FILES files / $PLANNED_LINES lines exceeds ${CURRENT} caps (${MAX_FILES} files / ${MAX_LINES} lines)"
  exit 0
fi

# Already H and still exceeded — must split. Suggest a concrete sub-issue count:
# the worse of (lines-overage, files-overage), ceil-divided by the H cap. The
# computed number is also an anti-fabrication tell — the orchestrator can't echo
# the right SUGGEST value without running the wrapper on the actual plan numbers.
SPLIT_BY_LINES=$(( (PLANNED_LINES + MAX_LINES - 1) / MAX_LINES ))
SPLIT_BY_FILES=$(( (PLANNED_FILES + MAX_FILES - 1) / MAX_FILES ))
SUGGEST=$SPLIT_BY_LINES; [ "$SPLIT_BY_FILES" -gt "$SUGGEST" ] && SUGGEST=$SPLIT_BY_FILES
[ "$SUGGEST" -lt 2 ] && SUGGEST=2
echo "Phase 2.0: SPLIT-REQUIRED — H bucket exceeded by planned $PLANNED_FILES files / $PLANNED_LINES lines (caps: $MAX_FILES files / $MAX_LINES lines). Split into ~$SUGGEST sub-issues before re-running — a single PR this size is unreviewable."
exit 0
