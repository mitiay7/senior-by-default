#!/bin/bash
# secret-scan — the ONLY supported way to produce the Phase 4.1 pre-push secret
# gate decision (PASS / BLOCK). Wrapper script, not inline spec bash / model
# judgment, for the same structural-coupling reason as pr-size-check and
# plan-size-check (anti-patterns §19 / §19g).
#
# Why: the pre-push secret check was instruction-only prose (git-rules.md glob
# list + regex hints applied by inspection). By the §19 ledger's own law, every
# instruction-only check was eventually skipped in production (metrics: 7
# audited bypasses; caveman: 2 documented prod bypasses; plan-size: 0/32
# rebumps recorded pre-wrapper; pr-size: 8 over-block PRs shipped as warn) —
# and this is the single UNRECOVERABLE skip in the pipeline: a pushed secret is
# revoke-and-rotate, not revert.
#
# Why the FULL PUSH RANGE, not `git diff --cached`: the old prose said to check
# the staged diff, but by Phase 4.1 the earlier Phase 2 commits are already in
# branch history — a secret committed (or committed-then-deleted) mid-
# implementation never appears in the final staged diff, yet every one of those
# blobs gets pushed. This wrapper scans every commit in
#     $(git merge-base origin/main HEAD)..HEAD
# via `git log -p` (file names + per-commit added lines, so add-then-delete is
# caught too). No origin/main / origin/master (or unrelated histories) →
# full-tree fallback: names + content of the entire HEAD tree.
#
# Usage:
#   secret-scan [-C <repo-dir>] [--base <ref>]
#     -C <repo-dir>  repo/worktree to scan (default: cwd)
#     --base <ref>   explicit range base (default: merge-base of origin/main —
#                    then origin/master — with HEAD; none resolvable → full tree)
#
# What it checks:
#   name globs (git-rules.md §Secret guard): .env* *.key *.pem credentials.*
#     *.secret id_rsa* *.p12 *.pfx — matched against basenames of every file
#     touched in the range. Template files (*.example *.sample *.template
#     *.dist) are exempt from the NAME check only; their CONTENT is still
#     scanned.
#   content patterns (added lines only): AWS AKIA keys, sk- API keys, Slack
#     xox* tokens, GitHub gh?_ tokens, PEM private-key blocks, signed JWTs,
#     quoted password/secret/api-key assignments.
#
# Output (stdout): first line is the verdict; BLOCK adds one indented line per
# finding (glob/pattern name + path — NEVER the matched secret text itself, so
# the finding list is safe to surface in transcripts). The verdict line carries
# the anti-fabrication tell: the real short SHAs of the scanned range plus
# commit/file counts — not reproducible without running the scan.
#
#   Phase 4.1: SECRETS PASS — range <base7>..<head7> clean (<N> commits, <M> files; globs=8 patterns=7)
#   Phase 4.1: SECRETS PASS — full-tree <head7> clean (<M> files; globs=8 patterns=7; no origin/main — fallback)
#   Phase 4.1: SECRETS BLOCK — <K> finding(s) in range <base7>..<head7> (<N> commits); STOP — do NOT push, alert user (revoke-and-rotate, not revert)
#     name-glob .env* → config/.env.local
#     content aws_access_key → src/deploy.sh (commit ab12cd3)
#
# Exit codes:
#   0  PASS  — push may proceed (the §4.1 block pushes ONLY on this exit)
#   3  BLOCK — HARD HALT. Do NOT push. Alert the user (git-rules.md §Secret
#      guard): remove the secret from branch history or rotate it, then re-run.
#      Never bypass by pushing outside the gated block.
#   1  REJECT (bad flag, not a git repo, unborn HEAD, git failure); stderr:
#      "REJECT <reason>". Fail closed — a REJECT is never a pass.

set -uo pipefail

die() { echo "REJECT $*" >&2; exit 1; }

REPO_DIR="."
BASE_REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    -C)        [ $# -ge 2 ] || die "-C requires a directory"; REPO_DIR="$2"; shift 2 ;;
    --base)    [ $# -ge 2 ] || die "--base requires a ref"; BASE_REF="$2"; shift 2 ;;
    -h|--help) sed -n '2,62p' "$0"; exit 0 ;;
    *) die "unknown flag: $1" ;;
  esac
done

git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $REPO_DIR"
HEAD_SHA=$(git -C "$REPO_DIR" rev-parse --verify HEAD 2>/dev/null) || die "unborn HEAD (no commits) — nothing to push, nothing to scan"
HEAD7=${HEAD_SHA:0:7}

# Forbidden name globs — verbatim from git-rules.md §Secret guard.
NAME_GLOBS=('.env*' '*.key' '*.pem' 'credentials.*' '*.secret' 'id_rsa*' '*.p12' '*.pfx')
# Documented-convention template files: exempt from the NAME check only
# (content is still scanned — a real key in .env.example still blocks).
TEMPLATE_GLOBS=('*.example' '*.sample' '*.template' '*.dist')

# Content patterns (POSIX ERE — matched with grep -E, never awk, because
# interval expressions {n,} are POSIX-guaranteed in grep but not in every awk).
# Names are what the finding list reports; the matched text is never printed.
CONTENT_PATTERNS=(
  'aws_access_key=AKIA[0-9A-Z]{16}'
  'sk_api_key=(^|[^A-Za-z0-9_])sk-[A-Za-z0-9_-]{20,}'
  'slack_token=xox[abprs]-[0-9A-Za-z-]{10,}'
  'github_token=gh[pousr]_[A-Za-z0-9]{36}'
  'private_key_block=-----BEGIN ([A-Z]+ )*PRIVATE KEY-----'
  'jwt_signed=eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{16,}'
  'secret_assignment=(password|passwd|secret|api[_-]?key|client[_-]?secret|signing[_-]?key|auth[_-]?token)["'\'']?[[:space:]]*[:=][[:space:]]*["'\''][^"'\''[:space:]]{12,}["'\'']'
)
# secret_assignment is matched case-insensitively (PASSWORD= / Password:).
nocase_for() { case "$1" in secret_assignment) echo 1 ;; *) echo 0 ;; esac; }

# Resolve the scan base: --base override, else origin/main, else origin/master.
BASE_SHA=""
if [ -n "$BASE_REF" ]; then
  BASE_SHA=$(git -C "$REPO_DIR" merge-base "$BASE_REF" HEAD 2>/dev/null) || die "--base $BASE_REF: cannot resolve a merge-base with HEAD"
else
  for cand in origin/main origin/master; do
    if BASE_SHA=$(git -C "$REPO_DIR" merge-base "$cand" HEAD 2>/dev/null); then
      break
    fi
    BASE_SHA=""
  done
fi

FINDINGS=()
GLOBS_N=${#NAME_GLOBS[@]}
PATS_N=${#CONTENT_PATTERNS[@]}

# Glob-check a newline-separated list of paths (basename match; template exempt).
# SC2254: unquoted $t/$g in the case patterns is INTENTIONAL — glob semantics
# are the whole point (matching basenames against the forbidden-name globs).
# shellcheck disable=SC2254
check_names() {
  local path base g t is_template
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    base="${path##*/}"
    is_template=0
    for t in "${TEMPLATE_GLOBS[@]}"; do
      case "$base" in
        $t) is_template=1; break ;;
      esac
    done
    [ "$is_template" -eq 1 ] && continue
    for g in "${NAME_GLOBS[@]}"; do
      case "$base" in
        $g) FINDINGS+=("  name-glob $g → $path"); break ;;
      esac
    done
  done
}

if [ -n "$BASE_SHA" ]; then
  # ---- Range mode: every commit in BASE..HEAD (names + added content) ------
  BASE7=${BASE_SHA:0:7}
  COMMITS=$(git -C "$REPO_DIR" rev-list --count "$BASE_SHA..HEAD" 2>/dev/null) || die "git rev-list failed for $BASE7..$HEAD7"

  NAMES=$(git -C "$REPO_DIR" log --format= --name-only --no-color "$BASE_SHA..HEAD" 2>/dev/null | sed '/^$/d' | sort -u) || die "git log --name-only failed"
  if [ -n "$NAMES" ]; then
    FILES=$(printf '%s\n' "$NAMES" | wc -l | tr -d ' ')
  else
    FILES=0
  fi
  check_names <<< "$NAMES"

  # Annotate every ADDED line of every commit with its file + commit, so a
  # per-pattern grep can attribute matches. Format: F:<path>|C:<sha7>|<content>
  PATCH_TMP=$(mktemp "${TMPDIR:-/tmp}/secret-scan.XXXXXX") || die "mktemp failed"
  ANNOT_TMP=$(mktemp "${TMPDIR:-/tmp}/secret-scan.XXXXXX") || { rm -f "$PATCH_TMP"; die "mktemp failed"; }
  trap 'rm -f "$PATCH_TMP" "$ANNOT_TMP"' EXIT

  git -C "$REPO_DIR" -c diff.external= log -p --format=%H --no-color --no-ext-diff --unified=0 "$BASE_SHA..HEAD" > "$PATCH_TMP" 2>/dev/null || die "git log -p failed for $BASE7..$HEAD7"

  awk '
    $0 ~ /^[0-9a-f]+$/ && length($0) == 40 { c = substr($0, 1, 7); next }
    /^\+\+\+ /  { f = substr($0, 5); sub(/^b\//, "", f); next }
    /^\+/       { print "F:" f "|C:" c "|" substr($0, 2) }
  ' "$PATCH_TMP" > "$ANNOT_TMP"

  for entry in "${CONTENT_PATTERNS[@]}"; do
    name="${entry%%=*}"; regex="${entry#*=}"
    ci=""
    [ "$(nocase_for "$name")" = "1" ] && ci="-i"
    hits=$(grep $ci -E -e "$regex" "$ANNOT_TMP" 2>/dev/null \
             | sed 's/^F:\([^|]*\)|C:\([^|]*\)|.*/\1 (commit \2)/' | sort -u) || true
    if [ -n "$hits" ]; then
      while IFS= read -r loc; do
        FINDINGS+=("  content $name → $loc")
      done <<< "$hits"
    fi
  done

  SCOPE_PASS="range $BASE7..$HEAD7 clean ($COMMITS commits, $FILES files; globs=$GLOBS_N patterns=$PATS_N)"
  SCOPE_BLOCK="range $BASE7..$HEAD7 ($COMMITS commits)"
else
  # ---- Full-tree fallback: no origin/main|master merge-base -----------------
  NAMES=$(git -C "$REPO_DIR" ls-tree -r --name-only HEAD 2>/dev/null | sort -u) || die "git ls-tree failed"
  if [ -n "$NAMES" ]; then
    FILES=$(printf '%s\n' "$NAMES" | wc -l | tr -d ' ')
  else
    FILES=0
  fi
  check_names <<< "$NAMES"

  for entry in "${CONTENT_PATTERNS[@]}"; do
    name="${entry%%=*}"; regex="${entry#*=}"
    ci=""
    [ "$(nocase_for "$name")" = "1" ] && ci="-i"
    hits=$(git -C "$REPO_DIR" grep -I -l $ci -E -e "$regex" HEAD -- 2>/dev/null \
             | sed 's/^HEAD://; s/$/ (HEAD tree)/' | sort -u) || true
    if [ -n "$hits" ]; then
      while IFS= read -r loc; do
        FINDINGS+=("  content $name → $loc")
      done <<< "$hits"
    fi
  done

  SCOPE_PASS="full-tree $HEAD7 clean ($FILES files; globs=$GLOBS_N patterns=$PATS_N; no origin/main — fallback)"
  SCOPE_BLOCK="full-tree $HEAD7 (no origin/main — fallback)"
fi

if [ "${#FINDINGS[@]}" -gt 0 ]; then
  echo "Phase 4.1: SECRETS BLOCK — ${#FINDINGS[@]} finding(s) in $SCOPE_BLOCK; STOP — do NOT push, alert user (a pushed secret is revoke-and-rotate, not revert)"
  printf '%s\n' "${FINDINGS[@]}"
  exit 3
fi

echo "Phase 4.1: SECRETS PASS — $SCOPE_PASS"
exit 0
