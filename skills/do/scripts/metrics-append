#!/bin/bash
# metrics-append — the ONLY supported way to write to a do-metrics JSONL log.
#
# Why a wrapper: production showed sub-agents systematically bypass any
# in-doc bash template, composing JSON freely via Write/echo/python.
# Centralizing emission behind a named-args CLI removes the freedom:
# the only path that produces a valid append is calling this script with
# the required flags, and unknown flags are rejected.
#
# Direct `echo ... >> $LOG_PATH` from sub-agents is an anti-pattern
# (see anti-patterns.md). The daily-report scanner flags entries that
# don't match the canonical shape, so bypasses are visible too.
#
# Usage:
#   metrics-append \
#     --log /path/to/repo.jsonl \
#     --ref i42 --complexity M --implementer sonnet --outcome merged \
#     --started-at 2026-05-15T08:00:00Z --ended-at 2026-05-15T08:30:00Z \
#     --files-changed 3 --lines-added 42 --lines-deleted 7 \
#     --sr-performed true --sr-claimed ready --sr-calibration accurate \
#     [--sr-calibration-defect accurate --sr-calibration-size false_positive]
#                                 # optional SPLIT of calibration into two de-confounded
#                                 # dimensions (enum: accurate|false_positive|false_negative|
#                                 # skipped|n_a; default n_a = not computed → use legacy
#                                 # `calibration`). defect = real code defect missed?;
#                                 # size = diff-size-only miss? See phase-4-finalize.md §4.11.
#     [--orchestrator opus-<version>]  # default: "opus" alias; pass the running model id from
#                                      # session metadata. Never hardcode a version (it rots at
#                                      # the next model release); omit to keep the "opus" alias.
#     [--complexity-rebumped-from M]  # optional: set if Phase 2.0 plan-size check
#                                     # re-routed the task. Value = ORIGINAL complexity
#                                     # before the bump (T|L|M, not H — H means already
#                                     # at top tier so no further bump possible).
#                                     # Omitted/empty = no rebump happened (common case).
#                                     # Recorded in entry as `complexity_rebumped_from`
#                                     # for downstream tracking of plan-size check
#                                     # effectiveness (how often does it fire? on which
#                                     # bucket transitions?).
#     [--gates-json '{...}' --phase-durations-json '{...}' --review-cycles 1 \
#      --ci-status skipped --auto-merge false --blocked-reason '' \
#      --title '...' --scope Backend --notes '...' \
#      --specialist-iterations-json '[]' --sr-miscalibrated-json '[]']
#
# Outcome enum (strictly enforced — production audit found 16 distinct values
# in entries pre-enforcement; canonical mapping below):
#   merged              — PR merged (auto-merge or manual). Includes `gh pr merge`
#                         success AND post-CI auto-merge completing.
#   ready_for_review    — PR opened, NOT auto-merged (manual review pending).
#                         Maps from informal values like pr_opened/pr_open.
#   blocked             — Phase 3 escalation after 3 failed cycles, draft PR
#                         with `blocked` label. NOT for "tests failed but
#                         resolved" — that's still merged or ready_for_review.
#
# Gate vocabulary (--gates-json keys, controlled but OPEN — see normalization
# block below). Canonical names:
#   build lint type_check test dep_vuln pr_size i18n contract ui_gate
#   migration_audit specialist_audit opus_review public_docs secret_scan
#   diff_scan plan_size codeowners stale_main concurrent_edit
# Common aliases (tests→test, i18n_gate→i18n, ui/visual_*→ui_gate,
# dep_vuln_go/pnpm→dep_vuln, type-check→type_check, go_vet/vet→lint, …) are
# normalized automatically. Unknown keys are PRESERVED (not rejected) but
# counted in the OK-line tell. Statuses coerce to pass|warn|fail|block|skipped.
#
# Exit codes:
#   0   appended successfully; stdout:
#         "OK pre=N post=N+1 path=<log> gates=<C> renamed=<R> noncanon=<list|->"
#   1   rejected (missing/invalid arg or schema-gate failed); stderr: "REJECT <reason>"
#   2   I/O failure (couldn't write to log, file lock, etc.)

set -euo pipefail

die() { echo "REJECT $*" >&2; exit 1; }
iofail() { echo "IOFAIL $*" >&2; exit 2; }

# --- Defaults for optional fields ---
TITLE=""
SCOPE=""
NOTES=""
BLOCKED_REASON=""
CI_STATUS="skipped"
AUTO_MERGE="false"
REVIEW_CYCLES="0"
GATES_JSON='{}'
PHASE_DURATIONS_JSON='{}'
SPECIALIST_ITERATIONS_JSON='[]'
SR_MISCALIBRATED_JSON='[]'
ORCHESTRATOR="opus"   # spec mandates orchestrator=opus; caller MAY pass running model id e.g. opus-<version> (never hardcode)
COMPLEXITY_REBUMPED_FROM=""   # optional: T|L|M if Phase 2.0 plan-size check re-routed; "" if no rebump
# Self-review calibration SPLIT dimensions (optional; default n_a = not computed by
# this caller — fall back to the legacy combined `calibration` field). The legacy
# `calibration` conflates "missed a real defect" with "didn't predict diff size";
# the split de-confounds them. See phase-4-finalize.md §4.11 "Calibration logic".
SR_CALIBRATION_DEFECT="n_a"   # real code defect Sonnet missed? (non-pr_size gate fail/block or specialist blocker)
SR_CALIBRATION_SIZE="n_a"     # diff-size-only miss? (pr_size warn/block as the sole concern)

# --- Required (no defaults; verified after parse) ---
LOG_PATH=""
REF=""
COMPLEXITY=""
IMPLEMENTER=""
OUTCOME=""
STARTED_AT=""
ENDED_AT=""
FILES_CHANGED=""
LINES_ADDED=""
LINES_DELETED=""
SR_PERFORMED=""
SR_CLAIMED=""
SR_CALIBRATION=""

# --- Parse args (long-options only; unknown = reject) ---
while [ $# -gt 0 ]; do
  case "$1" in
    --log)                       LOG_PATH="$2";                  shift 2 ;;
    --ref)                       REF="$2";                       shift 2 ;;
    --complexity)                COMPLEXITY="$2";                shift 2 ;;
    --implementer)               IMPLEMENTER="$2";               shift 2 ;;
    --outcome)                   OUTCOME="$2";                   shift 2 ;;
    --started-at)                STARTED_AT="$2";                shift 2 ;;
    --ended-at)                  ENDED_AT="$2";                  shift 2 ;;
    --files-changed)             FILES_CHANGED="$2";             shift 2 ;;
    --lines-added)               LINES_ADDED="$2";               shift 2 ;;
    --lines-deleted)             LINES_DELETED="$2";             shift 2 ;;
    --sr-performed)              SR_PERFORMED="$2";              shift 2 ;;
    --sr-claimed)                SR_CLAIMED="$2";                shift 2 ;;
    --sr-calibration)            SR_CALIBRATION="$2";            shift 2 ;;
    --sr-calibration-defect)     SR_CALIBRATION_DEFECT="$2";     shift 2 ;;
    --sr-calibration-size)       SR_CALIBRATION_SIZE="$2";       shift 2 ;;
    --sr-miscalibrated-json)     SR_MISCALIBRATED_JSON="$2";     shift 2 ;;
    --gates-json)                GATES_JSON="$2";                shift 2 ;;
    --phase-durations-json)      PHASE_DURATIONS_JSON="$2";      shift 2 ;;
    --review-cycles)             REVIEW_CYCLES="$2";             shift 2 ;;
    --ci-status)                 CI_STATUS="$2";                 shift 2 ;;
    --auto-merge)                AUTO_MERGE="$2";                shift 2 ;;
    --blocked-reason)            BLOCKED_REASON="$2";            shift 2 ;;
    --title)                     TITLE="$2";                     shift 2 ;;
    --scope)                     SCOPE="$2";                     shift 2 ;;
    --notes)                     NOTES="$2";                     shift 2 ;;
    --specialist-iterations-json) SPECIALIST_ITERATIONS_JSON="$2"; shift 2 ;;
    --orchestrator)              ORCHESTRATOR="$2";              shift 2 ;;
    --complexity-rebumped-from)  COMPLEXITY_REBUMPED_FROM="$2";  shift 2 ;;
    -h|--help)
      sed -n '4,60p' "$0"
      exit 0
      ;;
    *) die "unknown arg: $1" ;;
  esac
done

# --- Verify required ---
[ -n "$LOG_PATH" ]       || die "--log required"
[ -n "$REF" ]            || die "--ref required"
[ -n "$COMPLEXITY" ]     || die "--complexity required (T|L|M|H)"
[ -n "$IMPLEMENTER" ]    || die "--implementer required (haiku|sonnet|opus)"
[ -n "$OUTCOME" ]        || die "--outcome required"
[ -n "$STARTED_AT" ]     || die "--started-at required (ISO-8601 UTC)"
[ -n "$ENDED_AT" ]       || die "--ended-at required (ISO-8601 UTC)"
[ -n "$FILES_CHANGED" ]  || die "--files-changed required (int)"
[ -n "$LINES_ADDED" ]    || die "--lines-added required (int)"
[ -n "$LINES_DELETED" ]  || die "--lines-deleted required (int)"
[ -n "$SR_PERFORMED" ]   || die "--sr-performed required (true|false)"
[ -n "$SR_CLAIMED" ]     || die "--sr-claimed required (ready|deferred|uncertain|n/a)"
[ -n "$SR_CALIBRATION" ] || die "--sr-calibration required (accurate|false_positive|false_negative|skipped)"

# --- Enum / type validation (fail-fast, before jq) ---
[[ "$COMPLEXITY"     =~ ^[TLMH]$ ]]                                              || die "--complexity must be T|L|M|H, got: $COMPLEXITY"
[[ "$IMPLEMENTER"    =~ ^(haiku|sonnet|opus)$ ]]                                 || die "--implementer must be haiku|sonnet|opus, got: $IMPLEMENTER"
[[ "$OUTCOME"        =~ ^(merged|ready_for_review|blocked)$ ]]                   || die "--outcome must be merged|ready_for_review|blocked, got: $OUTCOME  (production audit found 16 distinct values for what should be 3; canonical mapping: PR merged via auto-merge or manually → 'merged'; PR opened, awaiting review → 'ready_for_review'; Phase 3 escalation (3 cycles unresolved) → 'blocked')"
[[ "$SR_PERFORMED"   =~ ^(true|false)$ ]]                                        || die "--sr-performed must be true|false, got: $SR_PERFORMED"
[[ "$SR_CLAIMED"     =~ ^(ready|deferred|uncertain|n/a)$ ]]                      || die "--sr-claimed invalid, got: $SR_CLAIMED"
[[ "$SR_CALIBRATION" =~ ^(accurate|false_positive|false_negative|skipped)$ ]]    || die "--sr-calibration invalid, got: $SR_CALIBRATION"
[[ "$SR_CALIBRATION_DEFECT" =~ ^(accurate|false_positive|false_negative|skipped|n_a)$ ]] || die "--sr-calibration-defect must be accurate|false_positive|false_negative|skipped|n_a, got: $SR_CALIBRATION_DEFECT"
[[ "$SR_CALIBRATION_SIZE"   =~ ^(accurate|false_positive|false_negative|skipped|n_a)$ ]] || die "--sr-calibration-size must be accurate|false_positive|false_negative|skipped|n_a, got: $SR_CALIBRATION_SIZE"
[[ "$AUTO_MERGE"     =~ ^(true|false)$ ]]                                        || die "--auto-merge must be true|false, got: $AUTO_MERGE"
[[ "$FILES_CHANGED"  =~ ^[0-9]+$ ]]                                              || die "--files-changed must be int, got: $FILES_CHANGED"
[[ "$LINES_ADDED"    =~ ^[0-9]+$ ]]                                              || die "--lines-added must be int, got: $LINES_ADDED"
[[ "$LINES_DELETED"  =~ ^[0-9]+$ ]]                                              || die "--lines-deleted must be int, got: $LINES_DELETED"
[[ "$REVIEW_CYCLES"  =~ ^[0-9]+$ ]]                                              || die "--review-cycles must be int, got: $REVIEW_CYCLES"
[[ "$ORCHESTRATOR"   =~ ^(opus|opus-[0-9.]+|haiku|sonnet|unknown)$ ]]            || die "--orchestrator must be opus[-N.M] (or haiku/sonnet for testing), got: $ORCHESTRATOR"
# Optional — empty means no Phase 2.0 plan-size re-route happened (the common case)
if [ -n "$COMPLEXITY_REBUMPED_FROM" ]; then
  [[ "$COMPLEXITY_REBUMPED_FROM" =~ ^[TLM]$ ]] \
    || die "--complexity-rebumped-from must be T|L|M (or omit entirely), got: $COMPLEXITY_REBUMPED_FROM"
  [ "$COMPLEXITY_REBUMPED_FROM" = "$COMPLEXITY" ] \
    && die "--complexity-rebumped-from cannot equal --complexity ($COMPLEXITY) — re-bump means routed tier > original tier"
fi

# Timestamp sanity: ended_at >= started_at. Catches the production pattern
# where sub-agents fill --ended-at with the moment of writing the entry but
# --started-at with a back-computed earlier time using wrong tz, producing
# negative cycle times (36% of pre-fix entries had this).
STARTED_EPOCH=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$STARTED_AT" "+%s" 2>/dev/null) \
  || die "--started-at not ISO-8601 UTC like 2026-05-21T08:30:00Z, got: $STARTED_AT"
ENDED_EPOCH=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ENDED_AT" "+%s" 2>/dev/null) \
  || die "--ended-at not ISO-8601 UTC like 2026-05-21T08:30:00Z, got: $ENDED_AT"
[ "$ENDED_EPOCH" -ge "$STARTED_EPOCH" ] \
  || die "--ended-at ($ENDED_AT) is before --started-at ($STARTED_AT) — negative cycle time. Most common cause: writing both timestamps near task END using wrong tz or back-computing started_at incorrectly. Fix: capture STARTED_AT at the moment task begins (Phase 0), not retroactively at Phase 4.13."

# Validate JSON payloads parse
for var in GATES_JSON PHASE_DURATIONS_JSON SPECIALIST_ITERATIONS_JSON SR_MISCALIBRATED_JSON; do
  echo "${!var}" | jq -e . >/dev/null 2>&1 || die "$var is not valid JSON: ${!var}"
done

# --- Gate-name + gate-status normalization (controlled vocabulary) ---
#
# Production audit (225 entries, May 14–24) found ~110 DISTINCT gate keys for
# ~19 real gates: `test`/`tests`/`test_gate`/`go_test`, `i18n`/`i18n_gate`,
# `contract`/`contract_gate`, `ui`/`ui_gate`/`visual_verify`/`visual_smoke`,
# `type_check`/`type-check`/`lint_typecheck`, `dep_vuln`/`dep_vuln_go`/`dep_vuln_pnpm`.
# Same fabrication class as the outcome-enum drift fixed in v0.6.0 — when the
# vocabulary is uncontrolled, each synonym splits a gate's stats across buckets
# and the daily-report's "gate failure rate" is meaningless. Gate STATUS was
# equally drifty (`skip`/`n/a`/`n-a`/`na`/`n_a`, scalar `pass`/`true`/`ok`/`clean`).
#
# Policy — gate keys are an OPEN set (legit task-specific checks exist, e.g.
# `idempotency_cache_correct`), unlike the closed outcome/complexity enums. So:
#   - known aliases  → silently renamed to the canonical name
#   - canonical keys → kept as-is
#   - UNKNOWN keys   → PRESERVED verbatim (not dropped, entry NOT rejected) but
#                      counted + surfaced in the OK-line tell. Warn-normalize,
#                      not hard-reject: rejecting on the announce-coupled critical
#                      path would tempt the orchestrator to drop real gate signal
#                      or fabricate. The closed enums stay hard-reject above.
# Statuses are coerced to the {pass|warn|fail|block|skipped} set (scalar gate
# values get wrapped as {status: <value>}); unknown statuses are preserved+flagged.
# On key collision after aliasing (e.g. both `test` and `go_test` present) the
# higher-severity status wins (block>fail>warn>pass>skipped).
#
# Anti-fabrication tell: the OK line echoes how many keys were renamed and lists
# any non-canonical keys. The orchestrator cannot reproduce those counts/lists
# without running the wrapper against the actual --gates-json payload.
GATE_NORM=$(jq -cn --argjson g "$GATES_JSON" '
  def canon: ["build","lint","type_check","test","dep_vuln","pr_size","i18n",
              "contract","ui_gate","migration_audit","specialist_audit","opus_review",
              "public_docs","secret_scan","diff_scan","plan_size","codeowners",
              "stale_main","concurrent_edit"];
  def kalias: {
    "tests":"test","test_gate":"test","go_test":"test","go_test_race":"test",
    "unit_tests":"test","integration_compile":"test","backend_test":"test",
    "backend_tests":"test","acceptance_tests":"test","api_client_tests":"test",
    "pdf_render_tests":"test","vitest":"test","3.1_test":"test",
    "i18n_gate":"i18n","i18n_parity":"i18n",
    "contract_gate":"contract","openapi_route_coverage":"contract","3.4_contract":"contract",
    "type-check":"type_check","lint_typecheck":"type_check","pnpm_type_check":"type_check",
    "tsc":"type_check","turbo_type_check":"type_check","frontend_typecheck":"type_check",
    "frontend_type_check":"type_check","owner_type_check":"type_check",
    "ui":"ui_gate","visual_verify":"ui_gate","visual_smoke":"ui_gate",
    "dep_vuln_go":"dep_vuln","dep_vuln_pnpm":"dep_vuln","dep_vuln_scan":"dep_vuln",
    "3.0.5_dep_vuln":"dep_vuln",
    "go_vet":"lint","vet":"lint","gofmt":"lint","pnpm_lint":"lint","owner_lint":"lint",
    "lint_owner":"lint","lefthook":"lint","lefthook_validate":"lint",
    "go_build":"build","codegen":"build","codegen_check":"build","schema_regen":"build",
    "low_diff_scan":"diff_scan","diff_review":"diff_scan","opus_diff_review":"diff_scan",
    "3.5_diff_scan":"diff_scan",
    "code_review":"specialist_audit","specialist":"specialist_audit",
    "specialists":"specialist_audit","specialist_audit_phase2":"specialist_audit",
    "specialist_audit_phase3":"specialist_audit","specialist_plan_review":"specialist_audit",
    "specialist_backend":"specialist_audit","specialist_security":"specialist_audit",
    "specialist_silent_failure":"specialist_audit","specialist_a11y":"specialist_audit",
    "silent_failure_audit":"specialist_audit","security_audit":"specialist_audit",
    "migration":"migration_audit","migration_zero_downtime":"migration_audit",
    "migration_up":"migration_audit","migration_goose_markers":"migration_audit",
    "migration_duplicate":"migration_audit",
    "secrets":"secret_scan","secret_check":"secret_scan",
    "3.0_pr_size":"pr_size","3.7_opus_review":"opus_review"
  };
  def salias: {
    "skip":"skipped","n/a":"skipped","n-a":"skipped","na":"skipped","n_a":"skipped",
    "not_applicable":"skipped","none":"skipped",
    "true":"pass","ok":"pass","clean":"pass","approve":"pass","approved":"pass",
    "changes_requested":"fail","deferred":"warn","partial":"warn"
  };
  def sev: {"block":4,"fail":3,"warn":2,"pass":1,"skipped":0};
  def normstatus:
    ((. // "pass") | tostring | ascii_downcase) as $s
    | (salias[$s])
      // (if   ($s|startswith("pass"))  then "pass"
          elif ($s|startswith("skip"))  then "skipped"
          elif ($s|startswith("block")) then "block"
          elif ($s|startswith("warn"))  then "warn"
          elif ($s|startswith("fail"))  then "fail"
          else $s end);
  def normval: (if type=="object" then . else {status:(.|tostring)} end)
             | .status = (.status | normstatus);
  ($g // {})
  | reduce (to_entries[]) as $e (
      {out:{}, renamed:{}, noncanon:[], noncanon_status:[]};
      ($e.key) as $rk
      | ($e.value | normval) as $nv
      | (kalias[$rk] // $rk) as $ck
      | (if (canon | index($ck)) != null
         then .out[$ck] = (if .out[$ck] == null then $nv
                           elif (sev[$nv.status] // -1) > (sev[.out[$ck].status] // -1) then $nv
                           else .out[$ck] end)
              | (if $ck != $rk then .renamed[$rk] = $ck else . end)
         else .out[$rk] = $nv | .noncanon += [$rk]
         end)
      | (if (sev[$nv.status]) == null
         then .noncanon_status += ["\($rk):\($nv.status)"] else . end)
    )
') || die "gate normalization failed (malformed --gates-json: $GATES_JSON)"

GATES_JSON=$(echo "$GATE_NORM"      | jq -c '.out')
GATE_RENAMED_COUNT=$(echo "$GATE_NORM" | jq '.renamed | length')
GATE_CANON_COUNT=$(echo "$GATE_NORM"   | jq '.out | length')
GATE_NONCANON_LIST=$(echo "$GATE_NORM" | jq -r 'if (.noncanon|length)==0 then "-" else (.noncanon | join(",")) end')
GATE_NONCANON_STATUS=$(echo "$GATE_NORM" | jq -r 'if (.noncanon_status|length)==0 then "" else (.noncanon_status | join(",")) end')
# Surface non-canonical gate keys / statuses on stderr too (visible in transcript,
# does not fail the entry — see policy note above).
if [ "$GATE_NONCANON_LIST" != "-" ]; then
  echo "NOTE gate-normalize: non-canonical gate key(s) preserved as-is: $GATE_NONCANON_LIST (not in the controlled vocabulary — see phase-4-finalize.md §4.11 gate list)" >&2
fi
if [ -n "$GATE_NONCANON_STATUS" ]; then
  echo "NOTE gate-normalize: non-canonical gate status(es) preserved: $GATE_NONCANON_STATUS (expected pass|warn|fail|block|skipped)" >&2
fi

# Anti-stub validation for specialist_iterations: reject if ANY cycle has
# auditors=[] AND approvers=[] AND blockers=[] (the i1023 fabrication
# pattern — sub-agent fabricated a 4-cycle structure with all-empty
# fields to satisfy the field-present requirement without actually
# running specialists). A real cycle has at least auditors populated
# (specialists were invoked), even if approvers/blockers are empty
# (everybody approved with no comments).
if [ "$SPECIALIST_ITERATIONS_JSON" != "[]" ]; then
  STUB_CYCLES=$(echo "$SPECIALIST_ITERATIONS_JSON" | jq '[.[] | select(
    ((.auditors // [])  | length == 0) and
    ((.approvers // []) | length == 0) and
    ((.blockers // [])  | length == 0)
  )] | length')
  [ "$STUB_CYCLES" -eq 0 ] || die "--specialist-iterations-json contains $STUB_CYCLES all-empty cycle(s) (auditors=[], approvers=[], blockers=[] — stub pattern observed in i1023 fabrication). Real cycles MUST have at least auditors populated. If specialists genuinely didn't run for a cycle, omit the cycle from the array — don't fabricate placeholder shape."
fi

# --- Build canonical entry via jq -n ---
JSON_ENTRY=$(jq -cn \
  --arg     ref             "$REF" \
  --arg     title           "$TITLE" \
  --arg     started_at      "$STARTED_AT" \
  --arg     ended_at        "$ENDED_AT" \
  --arg     complexity      "$COMPLEXITY" \
  --arg     scope           "$SCOPE" \
  --arg     orchestrator    "$ORCHESTRATOR" \
  --arg     rebumped_from   "$COMPLEXITY_REBUMPED_FROM" \
  --arg     implementer     "$IMPLEMENTER" \
  --argjson files_changed   "$FILES_CHANGED" \
  --argjson lines_added     "$LINES_ADDED" \
  --argjson lines_deleted   "$LINES_DELETED" \
  --argjson phase_durations "$PHASE_DURATIONS_JSON" \
  --argjson review_cycles   "$REVIEW_CYCLES" \
  --argjson gates           "$GATES_JSON" \
  --argjson sr_performed    "$SR_PERFORMED" \
  --arg     sr_claimed      "$SR_CLAIMED" \
  --arg     sr_calibration  "$SR_CALIBRATION" \
  --arg     sr_cal_defect   "$SR_CALIBRATION_DEFECT" \
  --arg     sr_cal_size     "$SR_CALIBRATION_SIZE" \
  --argjson sr_misc         "$SR_MISCALIBRATED_JSON" \
  --argjson specialist_iters "$SPECIALIST_ITERATIONS_JSON" \
  --arg     ci_status       "$CI_STATUS" \
  --argjson auto_merge      "$AUTO_MERGE" \
  --arg     outcome         "$OUTCOME" \
  --arg     blocked_reason  "$BLOCKED_REASON" \
  --arg     notes           "$NOTES" \
  '{
     ref:$ref, title:$title,
     started_at:$started_at, ended_at:$ended_at,
     complexity:$complexity,
   scope:$scope,
   orchestrator:$orchestrator,
   implementer:$implementer,
     files_changed:$files_changed, lines_added:$lines_added, lines_deleted:$lines_deleted,
     phase_durations_seconds:$phase_durations,
     review_cycles:$review_cycles,
     gates:$gates,
     self_review:{
       performed:$sr_performed,
       claimed_status:$sr_claimed,
       calibration:$sr_calibration,
       calibration_defect:$sr_cal_defect,
       calibration_size:$sr_cal_size,
       miscalibrated:$sr_misc
     },
     specialist_iterations:$specialist_iters,
     ci_status:$ci_status,
     auto_merge:$auto_merge,
     outcome:$outcome,
     blocked_reason:(if $blocked_reason=="" then null else $blocked_reason end)
   }
   + (if $notes == "" then {} else {notes:$notes} end)
   + (if $rebumped_from == "" then {} else {complexity_rebumped_from:$rebumped_from} end)') \
  || die "jq build failed (likely malformed --gates-json or --phase-durations-json)"

# --- Schema gate (defense in depth: in case caller passed valid-JSON-but-wrong-shape via the json flags) ---
echo "$JSON_ENTRY" | jq -e '
  (.ref            | type=="string" and length>0) and
  (.complexity     | test("^[TLMH]$"))            and
  (.orchestrator   | test("^(opus|opus-[0-9.]+|haiku|sonnet|unknown)$")) and
  (.implementer    | test("^(haiku|sonnet|opus)$")) and
  (.outcome        | test("^(merged|ready_for_review|blocked)$")) and
  (.files_changed  | type=="number")              and
  (.self_review.performed     | type=="boolean") and
  (.self_review.claimed_status| test("^(ready|deferred|uncertain|n/a)$")) and
  (.self_review.calibration   | test("^(accurate|false_positive|false_negative|skipped)$")) and
  (.self_review.calibration_defect | test("^(accurate|false_positive|false_negative|skipped|n_a)$")) and
  (.self_review.calibration_size   | test("^(accurate|false_positive|false_negative|skipped|n_a)$"))
' >/dev/null || die "schema gate failed (internal — please report)"

# --- Append + verify ---
mkdir -p "$(dirname "$LOG_PATH")" || iofail "cannot mkdir $(dirname "$LOG_PATH")"

if [ -f "$LOG_PATH" ]; then
  PRE_COUNT=$(wc -l < "$LOG_PATH" | tr -d ' ')
else
  PRE_COUNT=0
fi

if ! echo "$JSON_ENTRY" >> "$LOG_PATH"; then
  iofail "write to $LOG_PATH failed (exit $?)"
fi

POST_COUNT=$(wc -l < "$LOG_PATH" | tr -d ' ')
DELTA=$((POST_COUNT - PRE_COUNT))

if [ "$DELTA" -ne 1 ]; then
  iofail "append silent-fail: pre=$PRE_COUNT post=$POST_COUNT delta=$DELTA expected=1"
fi

echo "OK pre=$PRE_COUNT post=$POST_COUNT path=$LOG_PATH gates=$GATE_CANON_COUNT renamed=$GATE_RENAMED_COUNT noncanon=$GATE_NONCANON_LIST"
